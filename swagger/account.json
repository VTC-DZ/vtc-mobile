{
  "openapi": "3.1.0",
  "info": {
    "title": "VTC API",
    "description": "VTC platform API — account, passenger, driver, and admin surfaces.",
    "version": "0.1.0-SNAPSHOT"
  },
  "servers": [
    {
      "url": "http://vtc-api-dev.duckdns.org",
      "description": "Generated server url"
    }
  ],
  "tags": [
    {
      "name": "Account Notifications",
      "description": "The caller's notification inbox for their active role, plus account-level notifications"
    },
    {
      "name": "Account Push Token",
      "description": "Register or unregister the device push notification token"
    },
    {
      "name": "Account Profile",
      "description": "View and update the authenticated user's profile"
    },
    {
      "name": "Account Phone",
      "description": "Request and confirm a phone number change"
    },
    {
      "name": "Auth",
      "description": "Authentication — OTP login, token refresh, role switching"
    }
  ],
  "paths": {
    "/api/me/profile": {
      "get": {
        "tags": ["Account Profile"],
        "summary": "Get profile",
        "description": "Returns the authenticated user's profile.",
        "operationId": "getProfile",
        "responses": {
          "200": {
            "description": "Profile found",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/MeProfileResponse" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/MeProfileResponse" }
              }
            }
          }
        },
        "security": [{ "bearerAuth": [] }]
      },
      "put": {
        "tags": ["Account Profile"],
        "summary": "Update profile",
        "description": "Updates the authenticated user's profile fields.",
        "operationId": "updateProfile",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ProfileUpdateRequest" }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Profile updated",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/MeProfileResponse" }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/MeProfileResponse" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/MeProfileResponse" }
              }
            }
          }
        },
        "security": [{ "bearerAuth": [] }]
      }
    },
    "/api/me/push-token": {
      "post": {
        "tags": ["Account Push Token"],
        "summary": "Register push token",
        "description": "Registers or overwrites the device push token and platform for the authenticated user.",
        "operationId": "registerPushToken",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PushTokenRegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Push token registered",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/PushTokenResponse" }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/PushTokenResponse" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/PushTokenResponse" }
              }
            }
          }
        },
        "security": [{ "bearerAuth": [] }]
      },
      "delete": {
        "tags": ["Account Push Token"],
        "summary": "Unregister push token",
        "description": "Clears the authenticated user's device push token so this device stops receiving pushes. With the token parameter, clears only if that is the stored token. Idempotent. Logout does this automatically.",
        "operationId": "unregisterPushToken",
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "description": "This device's push token; when given, only this token is cleared",
            "required": false,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "204": { "description": "Token cleared (or there was none)" },
          "401": { "description": "Unauthorized" }
        },
        "security": [{ "bearerAuth": [] }]
      }
    },
    "/api/me/phone/request": {
      "post": {
        "tags": ["Account Phone"],
        "summary": "Request phone change",
        "description": "Sends an OTP to the new phone number to initiate a phone change.",
        "operationId": "requestPhoneChange",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ChangePhoneRequest" }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OTP sent to new phone",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/OtpRequestResponse" }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/OtpRequestResponse" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/OtpRequestResponse" }
              }
            }
          }
        },
        "security": [{ "bearerAuth": [] }]
      }
    },
    "/api/me/phone/confirm": {
      "post": {
        "tags": ["Account Phone"],
        "summary": "Confirm phone change",
        "description": "Verifies the OTP and completes the phone number change.",
        "operationId": "confirmPhoneChange",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePhoneConfirmRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Phone changed, new tokens issued",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/AuthTokensResponse" }
              }
            }
          },
          "400": {
            "description": "Invalid OTP or validation error",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/AuthTokensResponse" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/AuthTokensResponse" }
              }
            }
          }
        },
        "security": [{ "bearerAuth": [] }]
      }
    },
    "/api/me/notifications/{id}/read": {
      "post": {
        "tags": ["Account Notifications"],
        "summary": "Mark one notification read",
        "description": "Idempotent.",
        "operationId": "markRead",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "204": { "description": "Marked read (or already read)" },
          "401": { "description": "Unauthorized" },
          "404": {
            "description": "NOTIFICATION_NOT_FOUND — unknown ID or another user's item"
          }
        },
        "security": [{ "bearerAuth": [] }]
      }
    },
    "/api/me/notifications/read-all": {
      "post": {
        "tags": ["Account Notifications"],
        "summary": "Mark all notifications read",
        "description": "Marks every unread item in the inbox for the token's activeRole.",
        "operationId": "markAllRead",
        "responses": {
          "200": {
            "description": "Number of items newly marked read",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/ReadAllResponse" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/ReadAllResponse" }
              }
            }
          }
        },
        "security": [{ "bearerAuth": [] }]
      }
    },
    "/api/auth/switch-role": {
      "post": {
        "tags": ["Auth"],
        "summary": "Switch active role",
        "description": "Switches the user's active role between DRIVER and PASSENGER.",
        "operationId": "switchRole",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SwitchRoleRequest" }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Role switched",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/AccessTokenResponse" }
              }
            }
          },
          "400": {
            "description": "Invalid target role",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/AccessTokenResponse" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/AccessTokenResponse" }
              }
            }
          }
        },
        "security": [{ "bearerAuth": [] }]
      }
    },
    "/api/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "Refresh token",
        "description": "Exchanges a valid refresh token for a new token pair.",
        "operationId": "refresh",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RefreshTokenRequest" }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Tokens refreshed",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/AuthTokensResponse" }
              }
            }
          },
          "401": {
            "description": "Invalid or expired refresh token",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/AuthTokensResponse" }
              }
            }
          }
        }
      }
    },
    "/api/auth/otp/verify": {
      "post": {
        "tags": ["Auth"],
        "summary": "Verify OTP",
        "description": "Verifies the OTP code and returns authentication tokens.",
        "operationId": "verifyOtp",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/OtpVerifyRequest" }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Authentication successful",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/AuthTokensResponse" }
              }
            }
          },
          "401": {
            "description": "Invalid or expired OTP",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/AuthTokensResponse" }
              }
            }
          }
        }
      }
    },
    "/api/auth/otp/request": {
      "post": {
        "tags": ["Auth"],
        "summary": "Request OTP",
        "description": "Sends a one-time password to the given phone number.",
        "operationId": "requestOtp",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/OtpRequest" }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OTP sent successfully",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/OtpRequestResponse" }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/OtpRequestResponse" }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Logout",
        "description": "Invalidates the current user session and unregisters the device from push. Send this device's pushToken so only this device is unregistered.",
        "operationId": "logout",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LogoutRequest" }
            }
          }
        },
        "responses": {
          "204": { "description": "Logged out" },
          "401": { "description": "Unauthorized" }
        },
        "security": [{ "bearerAuth": [] }]
      }
    },
    "/api/me/email": {
      "patch": {
        "tags": ["Account Profile"],
        "summary": "Update email",
        "description": "Changes the authenticated user's email address.",
        "operationId": "updateEmail",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/EmailUpdateRequest" }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Email updated",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/MeProfileResponse" }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/MeProfileResponse" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/MeProfileResponse" }
              }
            }
          }
        },
        "security": [{ "bearerAuth": [] }]
      }
    },
    "/api/me/notifications": {
      "get": {
        "tags": ["Account Notifications"],
        "summary": "List notifications",
        "description": "Newest first. Shows the items for the token's activeRole plus account-level items, with title and body in the user's current preferred language.",
        "operationId": "list",
        "parameters": [
          {
            "name": "unreadOnly",
            "in": "query",
            "required": false,
            "schema": { "type": "boolean", "default": false }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "format": "int32", "default": 0 }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "format": "int32", "default": 20 }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of notifications",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponseNotificationResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponseNotificationResponse"
                }
              }
            }
          }
        },
        "security": [{ "bearerAuth": [] }]
      }
    },
    "/api/me/notifications/unread-count": {
      "get": {
        "tags": ["Account Notifications"],
        "summary": "Unread count",
        "description": "Number of unread notifications for the token's activeRole.",
        "operationId": "unreadCount",
        "responses": {
          "200": {
            "description": "Unread count",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/UnreadCountResponse" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/UnreadCountResponse" }
              }
            }
          }
        },
        "security": [{ "bearerAuth": [] }]
      }
    }
  },
  "components": {
    "schemas": {
      "ProfileUpdateRequest": {
        "type": "object",
        "properties": {
          "fullName": { "type": "string", "pattern": "^[\\p{L} '\\-]{2,100}$" },
          "gender": { "type": "string", "enum": ["MALE", "FEMALE"] },
          "dateOfBirth": { "type": "string", "format": "date" },
          "preferredLanguage": { "type": "string", "enum": ["FR", "AR"] }
        }
      },
      "DriverSummary": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "status": {
            "type": "string",
            "enum": ["ACTIVE", "BLOCKED", "SUSPENDED"]
          },
          "dateOfBirth": { "type": "string", "format": "date" },
          "kycStatus": {
            "type": "string",
            "enum": ["NONE", "PENDING", "APPROVED", "REJECTED", "REVOKED"]
          },
          "acceptsFemaleOnly": { "type": "boolean" },
          "vehicleCategory": {
            "type": "string",
            "enum": ["CAR", "MOTORCYCLE", "VAN"]
          },
          "vehicleTier": { "type": "string", "enum": ["STANDARD", "COMFORT"] },
          "isOnline": { "type": "boolean" },
          "requiresRekyc": { "type": "boolean" },
          "activeServiceTypes": {
            "type": "array",
            "items": { "type": "string", "enum": ["RIDE", "DELIVERY"] },
            "uniqueItems": true
          }
        }
      },
      "MeProfileResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "phone": { "type": "string" },
          "fullName": { "type": "string" },
          "gender": { "type": "string", "enum": ["MALE", "FEMALE"] },
          "email": { "type": "string" },
          "dateOfBirth": { "type": "string", "format": "date" },
          "preferredLanguage": { "type": "string", "enum": ["FR", "AR"] },
          "status": {
            "type": "string",
            "enum": ["ACTIVE", "BLOCKED", "SUSPENDED"]
          },
          "activeRole": { "type": "string" },
          "profileCompleted": { "type": "boolean" },
          "hasPassengerProfile": { "type": "boolean" },
          "hasDriverProfile": { "type": "boolean" },
          "passenger": { "$ref": "#/components/schemas/PassengerSummary" },
          "driver": { "$ref": "#/components/schemas/DriverSummary" }
        }
      },
      "PassengerSummary": {
        "type": "object",
        "properties": {
          "savedAddressCount": { "type": "integer", "format": "int32" }
        }
      },
      "PushTokenRegisterRequest": {
        "type": "object",
        "properties": {
          "token": { "type": "string", "maxLength": 4096, "minLength": 0 },
          "platform": { "type": "string", "enum": ["IOS", "ANDROID"] }
        },
        "required": ["platform", "token"]
      },
      "PushTokenResponse": {
        "type": "object",
        "properties": { "registered": { "type": "boolean" } }
      },
      "ChangePhoneRequest": {
        "type": "object",
        "properties": { "newPhone": { "type": "string", "minLength": 1 } },
        "required": ["newPhone"]
      },
      "OtpRequestResponse": {
        "type": "object",
        "properties": { "expiresIn": { "type": "integer", "format": "int32" } }
      },
      "ChangePhoneConfirmRequest": {
        "type": "object",
        "properties": {
          "newPhone": { "type": "string", "minLength": 1 },
          "code": { "type": "string", "minLength": 1, "pattern": "^\\d{6}$" }
        },
        "required": ["code", "newPhone"]
      },
      "AuthTokensResponse": {
        "type": "object",
        "properties": {
          "accessToken": { "type": "string" },
          "refreshToken": { "type": "string" },
          "isNewUser": { "type": "boolean" },
          "profileCompleted": { "type": "boolean" },
          "hasDriverProfile": { "type": "boolean" }
        }
      },
      "ReadAllResponse": {
        "type": "object",
        "properties": { "updated": { "type": "integer", "format": "int32" } }
      },
      "SwitchRoleRequest": {
        "type": "object",
        "properties": { "targetRole": { "type": "string" } },
        "required": ["targetRole"]
      },
      "AccessTokenResponse": {
        "type": "object",
        "properties": { "accessToken": { "type": "string" } }
      },
      "RefreshTokenRequest": {
        "type": "object",
        "properties": { "refreshToken": { "type": "string", "minLength": 1 } },
        "required": ["refreshToken"]
      },
      "OtpVerifyRequest": {
        "type": "object",
        "properties": {
          "phone": { "type": "string", "minLength": 1 },
          "code": { "type": "string", "minLength": 1, "pattern": "^\\d{6}$" }
        },
        "required": ["code", "phone"]
      },
      "OtpRequest": {
        "type": "object",
        "properties": { "phone": { "type": "string", "minLength": 1 } },
        "required": ["phone"]
      },
      "LogoutRequest": {
        "type": "object",
        "properties": {
          "pushToken": { "type": "string", "maxLength": 4096, "minLength": 0 }
        }
      },
      "EmailUpdateRequest": {
        "type": "object",
        "properties": { "email": { "type": "string" } }
      },
      "NotificationResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "eventKey": { "type": "string" },
          "title": { "type": "string" },
          "body": { "type": "string" },
          "data": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "read": { "type": "boolean" },
          "createdAt": { "type": "string", "format": "date-time" },
          "readAt": { "type": "string", "format": "date-time" }
        }
      },
      "PageResponseNotificationResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/NotificationResponse" }
          },
          "page": { "type": "integer", "format": "int32" },
          "size": { "type": "integer", "format": "int32" },
          "totalElements": { "type": "integer", "format": "int64" },
          "totalPages": { "type": "integer", "format": "int32" }
        }
      },
      "UnreadCountResponse": {
        "type": "object",
        "properties": { "count": { "type": "integer", "format": "int64" } }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "description": "Mobile JWT (passenger/driver)",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "adminBearerAuth": {
        "type": "http",
        "description": "Admin dashboard JWT",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
